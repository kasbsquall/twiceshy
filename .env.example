# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Stripe, test mode only. The app refuses to start with a live key.
STRIPE_SECRET_KEY=sk_test_

# Slack internal app with Socket Mode
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# A real user token (chat:write), used by demo and eval to post the CSM side of test threads
SLACK_USER_TOKEN=xoxp-
SLACK_DEMO_CHANNEL_ID=
SLACK_EVAL_CHANNEL_ID=
# Internal channel where approval cards and receipts are posted
SLACK_APPROVAL_CHANNEL_ID=

# Internal team: Slack user ID and role, comma separated. Roles: csm, cs_manager
INTERNAL_SLACK_USERS=U00000000:csm,U00000001:cs_manager
# Slack user IDs allowed to press Approve
APPROVER_SLACK_USER_IDS=U00000001

# HubSpot private app token (companies and notes, read and write)
HUBSPOT_ACCESS_TOKEN=

# Linear personal API key
LINEAR_API_KEY=
LINEAR_TEAM_KEY=INC
