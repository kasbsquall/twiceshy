{
  "name": "twiceshy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TwiceShy: customer success agent that settles SLA credits exactly once across Slack, HubSpot, Linear and Stripe.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx src/cli.ts demo",
    "demo:offline": "tsx src/cli.ts demo --offline",
    "approvals": "tsx src/approval/server.ts",
    "eval": "tsx src/eval/runEval.ts --k 3",
    "eval:quick": "tsx src/eval/runEval.ts --k 1",
    "seed": "tsx src/eval/seed.ts",
    "replay": "tsx src/cli.ts replay"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@hubspot/api-client": "14.0.1",
    "@linear/sdk": "95.0.0",
    "@slack/bolt": "5.1.0",
    "@slack/web-api": "8.1.1",
    "dotenv": "17.4.2",
    "p-limit": "7.3.2",
    "stripe": "22.6.2",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
